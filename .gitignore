# Python
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
dist/
build/
*.egg-info/

# Environment and editor state
.env
.env.*
!.env.example
.DS_Store
.idea/
.vscode/

# JavaScript
node_modules/
web/dist/

# Large/generated project data
data/raw/**
data/interim/**
data/processed/**
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
artifacts/model/**
artifacts/metrics/**
artifacts/replay/**
!artifacts/model/.gitkeep
!artifacts/metrics/.gitkeep
!artifacts/replay/.gitkeep
# The small, reviewed compressed replay bundle makes a clone runnable.
!artifacts/replay/reduced_c00_replay.json.gz
!artifacts/replay/reduced_c00_replay_metadata.json

# Submission media: keep editable source and small permitted release assets only.
# Raw recordings belong in external storage; commit a link or a compressed, reviewed
# release asset only when it is small enough for GitHub.
demo/*.mp4
demo/*.mov
demo/*.webm
assets/screenshots/*.mp4
assets/screenshots/*.mov
assets/screenshots/*.webm
