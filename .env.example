# Root used by pipeline scripts. Keep raw source files outside Git.
DATA_DIR=data

# Generated historical replay asset. Create it with `make replay` or obtain the
# approved artifact before starting the API.
REPLAY_ASSET_PATH=artifacts/replay/reduced_c00_replay.json.gz

# API host/port for local development.
API_HOST=127.0.0.1
API_PORT=8000
